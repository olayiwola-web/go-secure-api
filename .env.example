# Server
PORT=8080
HOST=0.0.0.0

# JWT (replace with a long random secret in production)
JWT_SECRET=change-me-to-a-long-random-secret

# Access token lifetime (minutes)
ACCESS_TOKEN_TTL_MINUTES=15

# Refresh token lifetime (hours) — also used as session TTL
REFRESH_TOKEN_TTL_HOURS=168

# Comma-separated wallet addresses that receive the admin role on login
ADMIN_WALLETS=0xadmin000000000000000000000000000000000001

# Rate limiting (requests per window per IP)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
